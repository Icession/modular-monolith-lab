# Copy to .env (gitignored) or put these in your IntelliJ Run Configuration.
# Never commit real values.

# --- Supabase (Labs 1-3) ---
# If db.<project-ref>.supabase.co fails with UnknownHostException, use the
# Session pooler: host aws-0-<region>.pooler.supabase.com, username postgres.<project-ref>
SUPABASE_DB_URL=jdbc:postgresql://<host>:5432/postgres
SUPABASE_DB_USERNAME=postgres.<project-ref>
SUPABASE_DB_PASSWORD=<your-db-password>
CORS_ALLOWED_ORIGIN=http://localhost:5173

# --- LegacySupply (Lab 3) ---
LS_CLIENT_ID=<your-student-id>
LS_API_KEY=<api-key-from-your-instructor>
